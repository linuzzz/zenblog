---
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer>
	&copy; 2026 By Linuzzz</br>
	Framework: Astro | Theme: Zen
	<div class="social-links">
		{SOCIAL_LINKS.github && (
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		)}
		{SOCIAL_LINKS.mastodon && (
			<a href={SOCIAL_LINKS.mastodon} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">mastodon</span>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="32" height="32" fill="currentColor" aria-hidden="true">
  					<path d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a4 4 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522q0-1.288.66-2.046c.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764q.662.757.661 2.046z"/>
				</svg>

			</a>
		)}
		{SOCIAL_LINKS.pixelfed && (
			<a href={SOCIAL_LINKS.pixelfed} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">pixelfed</span>
				<svg fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
  					<path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
				</svg>
			</a>
		)}
		{SOCIAL_LINKS.email && (
			<a href={SOCIAL_LINKS.email} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Email</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383l-4.708 2.825L15 11.105V5.383zm-.034 6.876L8.029 8.92 1.034 12.26A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.74zM1 11.105l4.708-2.897L1 5.383v5.722z"
					></path>
				</svg>
			</a>
		)}
	</div>
</footer>

<style>
	footer {
		padding: 1rem 1rem;
		background-color: var(--bg-primary);
		border-top: 1px solid var(--border-color);
		color: var(--text-muted);
		text-align: center;
		font-size: 0.875rem;
		transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
	.social-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
